{
  "name": "AGE动漫",
  "baseUrl": "https://www.agefans.cc",
  "browse": {
    "url": "/recommend",
    "list": "//div[contains(@class,'blockcontent')]/ul/li",
    "title": ".//a/text()",
    "cover": ".//img/@src",
    "link": ".//a/@href"
  },
  "search": {
    "url": "/search?query={keyword}&page={page}",
    "list": "//div[contains(@class,'blockcontent')]/ul/li",
    "title": ".//a/text()",
    "cover": ".//img/@src",
    "link": ".//a/@href"
  },
  "detail": {
    "summary": "//div[@class='detail']/p/text()",
    "tags": "//div[@class='detail']/span/text()",
    "cover": "//img[@class='poster']/@src",
    "chapters": "//div[@id='playlist']/a",
    "chapterTitle": ".//text()",
    "chapterLink": ".//@href"
  },
  "video": {
    "playUrl": "//iframe/@src",
    "resolutions": "//select[@class='resolution']/option/@value"
  }
}